{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyndrasystems.github.io/exitbind-evals/schemas/manifest-v1.schema.json",
  "title": "Exitbind corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "status", "repositories", "cases"],
  "properties": {
    "schema_version": {"const": "manifest-v1"},
    "name": {"const": "exitbind-acceptance-integrity-v1"},
    "status": {"enum": ["metadata-only", "executed"]},
    "repositories": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "url", "commit", "license_url", "fetch_verification"], "properties": {
        "id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "license_url": {"type": "string", "format": "uri"}, "fetch_verification": {"type": "string", "minLength": 1}
      }}
    },
    "cases": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
